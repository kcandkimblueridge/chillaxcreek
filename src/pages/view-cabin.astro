---
import BaseLayout from '../layouts/BaseLayout.astro';
import OwnerRezWidget from '../components/OwnerRezWidget.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import AmenityGrid from '../components/AmenityGrid.astro';

const amenityGroups = [
  {
    title: 'Scenic & Outdoor',
    icon: 'fa-tree',
    items: [
      'Lake view',
      'Waterfront',
      'Lake access',
      'Private entrance',
      'Patio or balcony',
      'Private backyard',
      'Fire pit',
      'Outdoor furniture',
      'Outdoor dining area',
      'Outdoor kitchen',
      'BBQ grill',
      'Sun loungers',
    ],
  },
  {
    title: 'Kitchen & Dining',
    icon: 'fa-utensils',
    items: [
      'Full kitchen',
      'Refrigerator',
      'Microwave',
      'Cooking basics',
      'Dishes & silverware',
      'Freezer',
      'Dishwasher',
      'Stainless steel electric stove',
      'Stainless steel single oven',
      'Hot water kettle',
      'Coffee maker',
      'Wine glasses',
      'Toaster',
      'Baking sheet',
      'Blender',
      'Rice maker',
      'Barbecue utensils',
      'Dining table',
      'Coffee provided',
    ],
  },
  {
    title: 'Entertainment',
    icon: 'fa-table-tennis-paddle-ball',
    items: [
      'Ethernet connection',
      'TV',
      'Game console',
      'Ping pong table',
      'Pool table',
      'Arcade games',
      'Life size games',
      'Board games',
    ],
  },
  {
    title: 'Bedroom & Laundry',
    icon: 'fa-bed',
    items: [
      'Free washer (in unit)',
      'Free dryer (in unit)',
      'Essentials',
      'Hangers',
      'Bed linens',
      'Room-darkening shades',
      'Iron',
      'Drying rack',
      'Dresser',
    ],
  },
  {
    title: 'Bathroom',
    icon: 'fa-bath',
    items: [
      'Hair dryer',
      'Cleaning products',
      'Shampoo',
      'Conditioner',
      'Body soap',
      'Hot water',
      'Shower gel',
    ],
  },
  {
    title: 'Heating & Cooling',
    icon: 'fa-temperature-half',
    items: [
      'Central air conditioning',
      'Indoor fireplace (gas, wood-burning)',
      'Ceiling fan',
      'Central heating',
    ],
  },
  {
    title: 'Internet & Office',
    icon: 'fa-wifi',
    items: ['Wifi', 'Dedicated workspace'],
  },
  {
    title: 'Family',
    icon: 'fa-people-group',
    items: ['Fireplace guards', 'Board games'],
  },
  {
    title: 'Parking & Facilities',
    icon: 'fa-charging-station',
    items: [
      'Free parking on premises',
      'Free street parking',
      'Private hot tub',
      'EV charger (Level 2)',
    ],
  },
  {
    title: 'Services',
    icon: 'fa-paw',
    items: [
      'Pets allowed',
      'Luggage dropoff allowed',
      'Long-term stays allowed',
      'Self check-in',
      'Smart lock',
    ],
  },
  {
    title: 'Safety',
    icon: 'fa-shield-halved',
    items: [
      'Exterior security cameras on property',
      'Smoke alarm',
      'Carbon monoxide alarm',
      'Fire extinguisher',
      'First aid kit',
    ],
  },
];

const sleeping = [
  {
    icon: 'fa-crown',
    title: 'Bedroom 1 — Top Level',
    subtitle: 'King bed',
    details: 'En-suite bathroom and private balcony with backyard views',
  },
  {
    icon: 'fa-bed',
    title: 'Bedroom 2 — Main Level',
    subtitle: 'Queen bed',
    details: 'TV, ceiling fan, and balcony access',
  },
  {
    icon: 'fa-hot-tub-person',
    title: 'Bedroom 3 — Lower Level',
    subtitle: 'Queen bed',
    details: 'En-suite bathroom and direct access to the hot tub',
  },
  {
    icon: 'fa-house-chimney',
    title: 'Loft',
    subtitle: '2 full beds',
    details: 'Open loft above the living room — perfect for kids or the young at heart',
  },
];
---

<BaseLayout
  title="View the Cabin | Chillax Creek"
  description="Tour every room and amenity at Chillax Creek — 45 photos, full amenity list, sleeping arrangement, and direct booking."
>
  <section class="vc-hero">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <h6 class="red-heading">Take the Tour</h6>
          <h2>View the Cabin</h2>
          <p class="vc-hero-lede">
            Browse every room and outdoor space at Chillax Creek. The cabin sleeps 8 across 3
            bedrooms plus a loft, with 3 full bathrooms, a fully stocked kitchen, a private game
            room, hot tub, fire pit, and a creek running through the backyard.
          </p>
          <div class="vc-hero-stats">
            <div><strong>3</strong><span>Bedrooms</span></div>
            <div><strong>5</strong><span>Beds</span></div>
            <div><strong>3</strong><span>Baths</span></div>
            <div><strong>8</strong><span>Sleeps</span></div>
            <div><strong>★ 4.97</strong><span>Airbnb rating</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="vc-gallery-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 port text-center">
          <h6 class="red-heading">45 photos · Click any to enlarge</h6>
          <h2>Photo Gallery</h2>
        </div>
      </div>
      <PhotoGallery />
    </div>
  </section>

  <section class="vc-sleeping">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <h6 class="red-heading">Where Everyone Sleeps</h6>
          <h2>Sleeping Arrangement</h2>
        </div>
      </div>
      <div class="sleep-grid">
        {
          sleeping.map((s) => (
            <div class="sleep-card">
              <div class="sleep-icon">
                <i class={`fa-solid ${s.icon}`}></i>
              </div>
              <h4>{s.title}</h4>
              <strong>{s.subtitle}</strong>
              <p>{s.details}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="vc-amenities">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 port">
          <h3>Amenities</h3>
          <h2>Full Amenity List</h2>
          <h6 class="red-heading">Everything included with your stay</h6>
        </div>
      </div>
      <AmenityGrid groups={amenityGroups} />
    </div>
  </section>

  <section class="vc-cta">
    <div class="container">
      <div class="row">
        <div class="col-lg-10 mx-auto text-center">
          <h6 class="red-heading">Save 20% over Airbnb rates</h6>
          <h2>Ready to book?</h2>
          <p>Check availability and reserve directly — no booking fees, fastest response time.</p>
        </div>
        <div class="col-lg-12">
          <div class="choosebar" style="margin-top: 30px;">
            <OwnerRezWidget />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .vc-hero {
    padding: 80px 0 50px;
  }
  .vc-hero-lede {
    max-width: 760px;
    margin: 0 auto 32px;
    color: #555;
    font-size: 17px;
    line-height: 1.6;
  }
  .vc-hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 30px;
  }
  .vc-hero-stats > div {
    background: #fff;
    border: 1px solid #efefef;
    border-radius: 12px;
    padding: 16px 24px;
    min-width: 110px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .vc-hero-stats strong {
    display: block;
    color: #b40000;
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .vc-hero-stats span {
    color: #666;
    font-size: 13px;
  }

  .vc-gallery-section {
    padding: 60px 0;
    background: #fafafa;
  }
  .vc-sleeping {
    padding: 80px 0;
  }
  .sleep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .sleep-card {
    background: #fff;
    border-radius: 16px;
    padding: 28px;
    text-align: center;
    border: 1px solid #efefef;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease;
  }
  .sleep-card:hover {
    transform: translateY(-2px);
  }
  .sleep-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    border-radius: 14px;
    background: linear-gradient(135deg, #b40000 0%, #8a0000 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .sleep-card h4 {
    margin: 0 0 4px;
    font-size: 15px;
    color: #888;
    font-weight: 500;
  }
  .sleep-card strong {
    display: block;
    font-size: 20px;
    color: #000;
    margin-bottom: 10px;
  }
  .sleep-card p {
    margin: 0;
    font-size: 14px;
    color: #555;
    line-height: 1.5;
  }

  .vc-amenities {
    padding: 80px 0;
    background: #fafafa;
  }
  .vc-cta {
    padding: 80px 0;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    color: #fff;
  }
  .vc-cta h2 { color: #fff; }
  .vc-cta p { color: rgba(255, 255, 255, 0.8); }
</style>
