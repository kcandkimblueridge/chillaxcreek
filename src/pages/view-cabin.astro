---
import BaseLayout from '../layouts/BaseLayout.astro';
import OwnerRezWidget from '../components/OwnerRezWidget.astro';
import photos from '../photos.json';

// Group amenities by category, sourced from the Airbnb listing.
const amenityGroups = [
  {
    title: 'Scenic & Outdoor',
    items: [
      'Lake view',
      'Waterfront',
      'Lake access',
      'Private entrance',
      'Patio or balcony',
      'Private backyard',
      'Fire pit',
      'Outdoor furniture',
      'Outdoor dining area',
      'Outdoor kitchen',
      'BBQ grill',
      'Sun loungers',
    ],
  },
  {
    title: 'Kitchen & Dining',
    items: [
      'Full kitchen',
      'Refrigerator',
      'Microwave',
      'Cooking basics',
      'Dishes & silverware',
      'Freezer',
      'Dishwasher',
      'Frigidaire stainless steel electric stove',
      'Stainless steel single oven',
      'Hot water kettle',
      'Coffee maker',
      'Wine glasses',
      'Toaster',
      'Baking sheet',
      'Blender',
      'Rice maker',
      'Barbecue utensils',
      'Dining table',
      'Coffee provided',
    ],
  },
  {
    title: 'Entertainment',
    items: [
      'Ethernet connection',
      'TV',
      'Game console',
      'Ping pong table',
      'Pool table',
      'Arcade games',
      'Life size games',
      'Board games',
    ],
  },
  {
    title: 'Bedroom & Laundry',
    items: [
      'Free washer (in unit)',
      'Free dryer (in unit)',
      'Essentials',
      'Hangers',
      'Bed linens',
      'Room-darkening shades',
      'Iron',
      'Drying rack',
      'Dresser',
    ],
  },
  {
    title: 'Bathroom',
    items: [
      'Hair dryer',
      'Cleaning products',
      'Shampoo',
      'Conditioner',
      'Body soap',
      'Hot water',
      'Shower gel',
    ],
  },
  {
    title: 'Heating & Cooling',
    items: [
      'Central air conditioning',
      'Indoor fireplace (gas, wood-burning)',
      'Ceiling fan',
      'Central heating',
    ],
  },
  {
    title: 'Internet & Office',
    items: ['Wifi', 'Dedicated workspace'],
  },
  {
    title: 'Family',
    items: ['Fireplace guards', 'Board games'],
  },
  {
    title: 'Parking & Facilities',
    items: [
      'Free parking on premises',
      'Free street parking',
      'Private hot tub',
      'EV charger (level 2)',
    ],
  },
  {
    title: 'Services',
    items: [
      'Pets allowed',
      'Luggage dropoff allowed',
      'Long-term stays allowed',
      'Self check-in',
      'Smart lock',
    ],
  },
  {
    title: 'Safety',
    items: [
      'Exterior security cameras on property',
      'Smoke alarm',
      'Carbon monoxide alarm',
      'Fire extinguisher',
      'First aid kit',
    ],
  },
];

const sleeping = [
  { title: 'Bedroom 1 — Top level', subtitle: 'King bed with en-suite bathroom and private balcony' },
  { title: 'Bedroom 2 — Main level', subtitle: 'Queen bed with TV, ceiling fan, and balcony access' },
  { title: 'Bedroom 3 — Lower level', subtitle: 'Queen bed with en-suite bath and hot tub access' },
  { title: 'Loft', subtitle: '2 full-size beds — perfect for kids or the young at heart' },
];
---

<BaseLayout
  title="View the Cabin | Chillax Creek"
  description="See every room and amenity at Chillax Creek — 45 photos, full amenity list, sleeping arrangement, and direct booking."
>
  <section class="home-sec1" style="padding-top: 60px;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <h6 class="red-heading">Take the Tour</h6>
          <h2>View the Cabin</h2>
          <p>
            Browse every room and outdoor space at Chillax Creek. The cabin sleeps 8 across 3
            bedrooms plus a loft, with 3 full bathrooms, a fully stocked kitchen, a private game
            room, hot tub, fire pit, and a creek running through the backyard.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="home-sec2">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 port">
          <h3>Photo Gallery</h3>
          <h2>Photo Gallery</h2>
          <h6 class="red-heading">45 photos of every space</h6>
        </div>
      </div>
      <div class="row">
        {
          photos.map((p) => (
            <div class="col-lg-4 col-md-6 col-12 mb-4">
              <figure style="margin: 0;">
                <img
                  src={p.src}
                  alt={p.caption}
                  loading="lazy"
                  style="width:100%; height: 280px; object-fit: cover; border-radius: 12px;"
                />
                {p.caption && (
                  <figcaption style="font-size: 0.9rem; color: #555; padding: 8px 4px 0;">
                    {p.caption}
                  </figcaption>
                )}
              </figure>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-sec1">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <h6 class="red-heading">Where Everyone Sleeps</h6>
          <h2>Sleeping Arrangement</h2>
        </div>
      </div>
      <div class="row">
        {
          sleeping.map((s) => (
            <div class="col-lg-6 col-md-6 mb-4">
              <div class="cart">
                <h4>{s.title}</h4>
                <p>{s.subtitle}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-sec2">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 port">
          <h3>Full Amenity List</h3>
          <h2>Full Amenity List</h2>
          <h6 class="red-heading">Everything included with your stay</h6>
        </div>
      </div>
      <div class="row" style="padding: 0 15px;">
        {
          amenityGroups.map((g) => (
            <div class="col-lg-4 col-md-6 mb-4">
              <h4 style="color: #B40000; font-weight: 600;">{g.title}</h4>
              <ul style="list-style: none; padding-left: 0;">
                {g.items.map((it) => (
                  <li style="padding: 4px 0;">✓ {it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-banner" style="height: auto; padding: 60px 0;">
    <div class="content" style="position: static;">
      <div class="container">
        <div class="row">
          <div class="col-lg-10 col-md-12 mx-auto">
            <h2 style="color: #fff; text-align: center;">Ready to book?</h2>
            <div class="choosebar">
              <OwnerRezWidget />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
