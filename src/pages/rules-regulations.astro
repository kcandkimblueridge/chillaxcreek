---
import BaseLayout from '../layouts/BaseLayout.astro';

const rules = [
  {
    title: 'Check-in & checkout',
    items: [
      'Check-in: after 4:00 PM (self check-in via smart lock)',
      'Checkout: before 10:00 AM',
      'Early check-in or late checkout may be available — please ask in advance',
    ],
  },
  {
    title: 'Guests',
    items: [
      'Maximum 8 guests',
      'No parties or events',
      'No additional unregistered overnight guests',
    ],
  },
  {
    title: 'Pets',
    items: [
      'Dogs welcome — must be potty trained',
      'Keep an eye on your pet to prevent accidents or property damage',
      'Pick up and dispose of pet waste outdoors',
      'No pets on furniture or beds',
    ],
  },
  {
    title: 'Smoking & alcohol',
    items: [
      'No smoking inside the cabin',
      'Outdoor smoking permitted on the patio (please use the provided ashtray)',
    ],
  },
  {
    title: 'Property care',
    items: [
      'Treat the cabin like your own home',
      'Report any damage or issues immediately so we can address them',
      'Trash bags and cleaning supplies are provided — please bag trash before checkout',
      'Hot tub: rinse off before entering, no glass in the tub area',
      'Fire pit: only use the provided firewood — never leave a fire unattended',
    ],
  },
  {
    title: 'Quiet hours',
    items: [
      'Quiet hours: 10:00 PM – 8:00 AM',
      'Be considerate of nearby neighbors',
    ],
  },
  {
    title: 'Safety',
    items: [
      'Exterior security cameras are present on the property (no interior cameras)',
      'Smoke and carbon monoxide alarms are tested regularly',
      'First aid kit and fire extinguisher located in the kitchen',
    ],
  },
];
---

<BaseLayout
  title="Rules & Regulations | Chillax Creek"
  description="House rules and regulations for guests at Chillax Creek cabin in Blue Ridge, Georgia."
>
  <section class="legal-hero">
    <div class="container">
      <h6 class="red-heading">Please read before booking</h6>
      <h2>Rules &amp; Regulations</h2>
      <p>
        Chillax Creek is our home away from home, and we hope it becomes that for you too. To keep
        the cabin in top shape for every guest, please review and follow these house rules during
        your stay.
      </p>
    </div>
  </section>

  <section class="legal-content">
    <div class="container">
      <div class="info-card-grid">
        {
          rules.map((r) => (
            <article class="info-card">
              <h4>{r.title}</h4>
              <ul>
                {r.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="legal-footnote">
        Questions about any of the above? <a href="/contact-us/">Reach out</a> before you book —
        we&rsquo;re happy to clarify.
      </div>
    </div>
  </section>
</BaseLayout>
