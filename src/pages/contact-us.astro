---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact Us | Chillax Creek"
  description="Get in touch with Alton & Mary about Chillax Creek cabin in Blue Ridge, Georgia. Phone, email, or contact form."
>
  <section class="contact-page">
    <div class="container">
      <div class="contact-hero">
        <h2>We&rsquo;d love to hear from you</h2>
        <p>
          Have a question about the cabin, a special request, or want to check on a date that
          isn&rsquo;t showing? Drop us a note — we usually reply within an hour during the day.
        </p>
      </div>

      <div class="contact-grid">
        <aside class="contact-aside">
          <div class="contact-card">
            <a href="mailto:hello@shiftclick.io" class="contact-method">
              <span class="contact-icon"><i class="fa-solid fa-envelope"></i></span>
              <span class="contact-text">
                <span class="contact-label">Email</span>
                <span class="contact-value">hello@shiftclick.io</span>
              </span>
            </a>
          </div>

          <div class="hosts-card">
            <div class="hosts-avatar">
              <i class="fa-solid fa-mug-hot"></i>
            </div>
            <div>
              <span class="hosts-label">Your hosts</span>
              <strong class="hosts-name">Alton &amp; Mary</strong>
              <p class="hosts-blurb">
                We&rsquo;re a real couple, not a property manager. You&rsquo;ll talk to us directly.
              </p>
            </div>
          </div>

          <div class="social-card">
            <span class="social-label">Find us on social</span>
            <div class="social-row">
              <a
                href="https://www.facebook.com/ChillaxCreek/"
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                <i class="fa-brands fa-facebook-f"></i>
              </a>
              <a
                href="https://www.instagram.com/chillax_creek/"
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <i class="fa-brands fa-instagram"></i>
              </a>
            </div>
          </div>
        </aside>

        <div class="contact-form-card">
          <h3>Send us a message</h3>
          <p class="form-blurb">
            Fill in what you can — we&rsquo;ll get back to you with availability, pricing, or
            answers to whatever you&rsquo;re wondering about.
          </p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .contact-page {
    padding: 140px 0 100px;
    background: linear-gradient(180deg, #fafafa 0%, #fff 60%);
  }
  .contact-hero {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px;
  }
  .contact-hero p {
    color: #555;
    font-size: 17px;
    line-height: 1.6;
    margin-top: 14px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Aside cards */
  .contact-card,
  .hosts-card,
  .social-card,
  .contact-form-card {
    background: #fff;
    border: 1px solid #efefef;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-card {
    padding: 8px 0;
  }
  .contact-method {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 24px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .contact-method:hover {
    background: #fafafa;
    color: inherit;
  }
  .contact-method + .contact-method {
    border-top: 1px solid #f3f3f3;
  }
  .contact-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, #b40000 0%, #8a0000 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .contact-label {
    color: #888;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .contact-value {
    color: #111;
    font-weight: 600;
    font-size: 16px;
  }

  /* Hosts card */
  .hosts-card {
    padding: 22px 24px;
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .hosts-avatar {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fff5f5;
    border: 2px solid #f4c8c8;
    color: #b40000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .hosts-label {
    display: block;
    color: #888;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }
  .hosts-name {
    display: block;
    color: #111;
    font-size: 18px;
    margin-bottom: 6px;
  }
  .hosts-blurb {
    color: #666;
    font-size: 13px;
    margin: 0;
    line-height: 1.5;
  }

  /* Social */
  .social-card {
    padding: 18px 24px 22px;
  }
  .social-label {
    display: block;
    color: #888;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .social-row {
    display: flex;
    gap: 10px;
  }
  .social-row a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f6f6f6;
    color: #333;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .social-row a:hover {
    background: #b40000;
    color: #fff;
    transform: translateY(-2px);
  }

  /* Form card */
  .contact-form-card {
    padding: 36px 36px 32px;
  }
  .contact-form-card h3 {
    margin: 0 0 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #111;
  }
  .form-blurb {
    color: #666;
    font-size: 14.5px;
    margin: 0 0 24px;
    line-height: 1.5;
  }
  .contact-form-card form .row {
    --bs-gutter-x: 16px;
    row-gap: 16px;
  }
  .contact-form-card label {
    display: block;
    color: #444;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 6px;
    text-transform: none;
    letter-spacing: 0;
  }
  .contact-form-card input:not([type='submit']),
  .contact-form-card textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background: #fafafa;
    color: #111;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .contact-form-card textarea {
    height: auto;
    min-height: 130px;
    resize: vertical;
  }
  .contact-form-card input:not([type='submit'])::placeholder,
  .contact-form-card textarea::placeholder {
    color: #aaa;
  }
  .contact-form-card input:not([type='submit']):focus,
  .contact-form-card textarea:focus {
    outline: none;
    border-color: #b40000;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(180, 0, 0, 0.1);
  }
  .contact-form-card input[type='submit'] {
    margin-top: 10px;
    width: auto;
    min-width: 180px;
    padding: 13px 28px;
    background: linear-gradient(135deg, #b40000 0%, #8a0000 100%);
    color: #fff;
    border: none;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .contact-form-card input[type='submit']:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(180, 0, 0, 0.25);
  }

  @media (max-width: 991px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .contact-form-card {
      padding: 28px 24px 24px;
    }
  }
  @media (max-width: 576px) {
    .contact-page { padding: 120px 0 60px; }
    .contact-hero { margin-bottom: 32px; }
  }
</style>

