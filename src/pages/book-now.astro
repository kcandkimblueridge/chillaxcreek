---
import BaseLayout from '../layouts/BaseLayout.astro';
import OwnerRezWidget from '../components/OwnerRezWidget.astro';

const benefits = [
  {
    icon: 'fa-tag',
    title: 'No booking fees',
    text: 'Skip the platform service fees — you only pay the rate plus taxes and cleaning.',
  },
  {
    icon: 'fa-percent',
    title: 'Best rate guarantee',
    text: '20% off our Airbnb rates. We price-match to make sure direct booking is always the cheaper option.',
  },
  {
    icon: 'fa-comments',
    title: 'Talk to us directly',
    text: 'You reach Alton & Mary, not a property manager. Fast replies, real answers.',
  },
  {
    icon: 'fa-calendar-check',
    title: 'Flexible stays',
    text: 'Long-term stays welcome. Reach out for custom rates on extended bookings.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Pick your dates',
    text: 'Use the calendar to check availability and see your total — taxes and cleaning included.',
  },
  {
    n: '2',
    title: 'Book in seconds',
    text: 'Reserve directly through OwnerRez. Secure payment, instant confirmation.',
  },
  {
    n: '3',
    title: 'Self check-in',
    text: 'Smart-lock code sent before arrival. Settle in whenever works for you.',
  },
];
---

<BaseLayout
  title="Book Now | Chillax Creek"
  description="Check availability and book your stay at Chillax Creek directly. Save 20% over Airbnb rates."
>
  <section class="bn-hero">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <h6 class="red-heading">Save 20% over Airbnb rates</h6>
          <h2>Book your stay direct</h2>
          <p class="bn-lede">
            Reserve through us and skip the third-party fees. Real-time availability, instant
            confirmation, and the lowest rate you&rsquo;ll find online.
          </p>
          <div class="bn-stats">
            <div><strong>20%</strong><span>off Airbnb rates</span></div>
            <div><strong>$0</strong><span>booking fees</span></div>
            <div><strong>★ 4.97</strong><span>guest rating</span></div>
            <div><strong>49+</strong><span>5-star reviews</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bn-widget-section">
    <div class="container">
      <div class="bn-widget-card">
        <div class="bn-widget-head">
          <h6 class="red-heading">Live availability</h6>
          <h3>Check dates &amp; rates</h3>
          <p>
            Pick your check-in and check-out dates below. Pricing updates instantly — no surprises
            at checkout.
          </p>
        </div>
        <div class="bn-widget-body">
          <OwnerRezWidget />
        </div>
      </div>
    </div>
  </section>

  <section class="bn-benefits">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <h6 class="red-heading">Why book direct</h6>
          <h2>More than just a better price</h2>
        </div>
      </div>
      <div class="bn-benefit-grid">
        {
          benefits.map((b) => (
            <div class="bn-benefit-card">
              <div class="bn-benefit-icon">
                <i class={`fa-solid ${b.icon}`} />
              </div>
              <h4>{b.title}</h4>
              <p>{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bn-steps">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <h6 class="red-heading">How it works</h6>
          <h2>From browse to keys in three steps</h2>
        </div>
      </div>
      <div class="bn-steps-grid">
        {
          steps.map((s) => (
            <div class="bn-step">
              <div class="bn-step-num">{s.n}</div>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bn-help">
    <div class="container">
      <div class="bn-help-card">
        <div class="bn-help-text">
          <h6 class="red-heading">Need a hand?</h6>
          <h3>Have a question before you book?</h3>
          <p>
            Custom dates, group size, pet policy, anything else — we&rsquo;re happy to help.
            Usually back to you within an hour during the day.
          </p>
        </div>
        <div class="bn-help-actions">
          <a href="/contact-us/" class="bn-btn bn-btn-primary">
            <i class="fa-solid fa-paper-plane"></i> Send a message
          </a>
          <a href="tel:+15045070558" class="bn-btn bn-btn-secondary">
            <i class="fa-solid fa-phone"></i> Call or text
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .bn-hero {
    padding: 140px 0 50px;
    background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
    text-align: center;
  }
  .bn-lede {
    max-width: 720px;
    margin: 0 auto 28px;
    color: #555;
    font-size: 17px;
    line-height: 1.6;
  }
  .bn-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }
  .bn-stats > div {
    background: #fff;
    border: 1px solid #efefef;
    border-radius: 12px;
    padding: 16px 24px;
    min-width: 140px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .bn-stats strong {
    display: block;
    color: #b40000;
    font-family: 'Poppins', sans-serif;
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .bn-stats span {
    color: #666;
    font-size: 13px;
  }

  .bn-widget-section {
    padding: 50px 0 80px;
  }
  .bn-widget-card {
    background: #fff;
    border-radius: 22px;
    border: 1px solid #efefef;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }
  .bn-widget-head {
    text-align: center;
    padding: 36px 32px 12px;
  }
  .bn-widget-head h3 {
    margin: 4px 0 10px;
    font-family: 'Poppins', sans-serif;
    font-size: 26px;
    font-weight: 600;
    color: #111;
  }
  .bn-widget-head p {
    color: #555;
    font-size: 15px;
    line-height: 1.55;
    max-width: 520px;
    margin: 0 auto;
  }
  .bn-widget-body {
    padding: 24px 32px 36px;
  }

  .bn-benefits {
    padding: 80px 0;
    background: #fafafa;
  }
  .bn-benefit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .bn-benefit-card {
    background: #fff;
    border-radius: 16px;
    padding: 28px 24px;
    border: 1px solid #efefef;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .bn-benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
  }
  .bn-benefit-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #b40000 0%, #8a0000 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 16px;
  }
  .bn-benefit-card h4 {
    margin: 0 0 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #111;
  }
  .bn-benefit-card p {
    margin: 0;
    color: #555;
    font-size: 14px;
    line-height: 1.55;
  }

  .bn-steps {
    padding: 80px 0;
  }
  .bn-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  .bn-step {
    text-align: center;
    padding: 24px 18px;
  }
  .bn-step-num {
    width: 48px;
    height: 48px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: linear-gradient(135deg, #b40000 0%, #8a0000 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 18px;
  }
  .bn-step h4 {
    margin: 0 0 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #111;
  }
  .bn-step p {
    margin: 0;
    color: #555;
    font-size: 14.5px;
    line-height: 1.55;
  }

  .bn-help {
    padding: 0 0 100px;
  }
  .bn-help-card {
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border-radius: 22px;
    padding: 44px 48px;
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .bn-help-text {
    flex: 1;
    min-width: 280px;
  }
  .bn-help-card h3 {
    color: #fff;
    margin: 4px 0 10px;
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 600;
  }
  .bn-help-card p {
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    max-width: 540px;
  }
  .bn-help-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .bn-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 24px;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .bn-btn-primary {
    background: linear-gradient(135deg, #b40000 0%, #8a0000 100%);
    color: #fff;
  }
  .bn-btn-primary:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(180, 0, 0, 0.3);
  }
  .bn-btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .bn-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 767px) {
    .bn-hero { padding: 120px 0 40px; }
    .bn-widget-head { padding: 28px 22px 8px; }
    .bn-widget-body { padding: 18px 18px 28px; }
    .bn-help-card { padding: 32px 24px; }
  }
</style>
