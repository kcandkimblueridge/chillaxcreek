---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';
import '../styles/responsive.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Chillax Creek | Cabin Rental in Blue Ridge, GA',
  description = 'Premium 3-bedroom vacation cabin in Blue Ridge, Georgia. Sleeps 8, private creek, hot tub, game room, pet friendly. Book direct and save.',
} = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/cropped-chillax-fav-32x32.png" />
    <link rel="apple-touch-icon" href="/images/cropped-chillax-fav-180x180.png" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/swiper@10/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" is:inline></script>
    <script src="https://unpkg.com/swiper@10/swiper-bundle.min.js" is:inline></script>
    <script is:inline>
      // FAQ accordion (preserves original UX)
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.accordian > li > h5').forEach((h) => {
          h.addEventListener('click', () => {
            const li = h.parentElement;
            li.classList.toggle('active');
            const content = li.querySelector('.content');
            if (content) {
              content.style.display = content.style.display === 'block' ? 'none' : 'block';
            }
          });
        });

        // Initialize Swiper for any .mySwiper instances
        if (typeof Swiper !== 'undefined') {
          document.querySelectorAll('.swiper.mySwiper').forEach((el) => {
            new Swiper(el, {
              loop: true,
              autoplay: { delay: 4500 },
              pagination: { el: el.querySelector('.swiper-pagination'), clickable: true },
            });
          });
          document.querySelectorAll('.group_slide .swiper-container').forEach((el) => {
            new Swiper(el, {
              slidesPerView: 4,
              spaceBetween: 20,
              loop: true,
              autoplay: { delay: 3500 },
              navigation: {
                nextEl: el.querySelector('.swiper-button-next'),
                prevEl: el.querySelector('.swiper-button-prev'),
              },
              breakpoints: {
                0: { slidesPerView: 1 },
                576: { slidesPerView: 2 },
                992: { slidesPerView: 3 },
                1200: { slidesPerView: 4 },
              },
            });
          });
        }
      });
    </script>
  </body>
</html>
