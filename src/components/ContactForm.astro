---
// Formspree endpoint for the main contact form.
// Replace FORMSPREE_CONTACT_ID with the form ID from your Formspree dashboard.
const FORMSPREE_CONTACT = 'https://formspree.io/f/FORMSPREE_CONTACT_ID';
---

<form action={FORMSPREE_CONTACT} method="POST">
  <input type="hidden" name="_subject" value="New Chillax Creek inquiry" />
  <div class="row">
    <div class="col-lg-6 col-md-6">
      <label for="cf-name">Full Name</label>
      <input id="cf-name" type="text" name="name" placeholder="John Doe" required />
    </div>
    <div class="col-lg-6 col-md-6">
      <label for="cf-email">Email Address</label>
      <input id="cf-email" type="email" name="email" placeholder="johndoe@gmail.com" required />
    </div>
    <div class="col-lg-6 col-md-6">
      <label for="cf-phone">Phone</label>
      <input id="cf-phone" type="tel" name="phone" placeholder="+1 (504) 555-1234" />
    </div>
    <div class="col-lg-6 col-md-6">
      <label for="cf-budget">Budget</label>
      <input id="cf-budget" type="text" name="budget" placeholder="$800" />
    </div>
    <div class="col-lg-12 col-md-12">
      <label for="cf-from">From</label>
      <input id="cf-from" type="text" name="from_location" placeholder="Boston" />
    </div>
    <div class="col-lg-12">
      <label for="cf-message">Message</label>
      <textarea
        id="cf-message"
        name="message"
        cols="30"
        rows="10"
        placeholder="Tell us about your stay..."
        required></textarea>
    </div>
    <div class="col-lg-12">
      <input type="submit" value="Send Now" />
    </div>
  </div>
</form>
