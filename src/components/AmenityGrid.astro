---
interface Group {
  title: string;
  icon: string;
  items: string[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props as Props;
---

<div class="amenity-grid">
  {
    groups.map((g) => (
      <div class="amenity-card">
        <div class="amenity-card-header">
          <span class="amenity-icon">
            <i class={`fa-solid ${g.icon}`}></i>
          </span>
          <h4>{g.title}</h4>
        </div>
        <ul class="amenity-list">
          {g.items.map((it) => (
            <li>
              <i class="fa-solid fa-check"></i>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style is:global>
  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 30px;
  }
  .amenity-card {
    background: #fff;
    border-radius: var(--cc-radius-lg);
    padding: 24px;
    border: 1px solid var(--cc-border);
    box-shadow: var(--cc-shadow-card);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .amenity-card:hover {
    transform: translateY(-3px);
    border-color: var(--cc-border-strong);
    box-shadow: var(--cc-shadow-card-hover);
  }
  .amenity-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--cc-border);
  }
  .amenity-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--cc-radius-md);
    background: rgba(180, 0, 0, 0.08);
    color: var(--cc-red);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .amenity-card h4 {
    margin: 0;
    color: var(--cc-text);
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 600;
  }
  .amenity-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .amenity-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 6px 0;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: var(--cc-muted);
    line-height: 1.55;
  }
  .amenity-list li i {
    color: var(--cc-red);
    font-size: 11px;
    margin-top: 5px;
    flex-shrink: 0;
  }
</style>
