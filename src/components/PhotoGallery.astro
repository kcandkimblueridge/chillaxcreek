---
import photos from '../photos.json';
---

<div class="cc-gallery">
  <div class="cc-gallery-grid" id="cc-gallery-grid">
    {
      photos.map((p: any, i: number) => (
        <button
          type="button"
          class="cc-thumb"
          data-idx={i}
          aria-label={p.caption || `Photo ${i + 1}`}
        >
          <img src={p.src} alt={p.caption || ''} loading="lazy" />
          {i === 0 && <span class="cc-thumb-overlay">Click any photo</span>}
        </button>
      ))
    }
  </div>

  <div class="cc-lightbox" id="cc-lightbox" hidden>
    <button class="cc-lb-close" type="button" aria-label="Close">×</button>
    <button class="cc-lb-prev" type="button" aria-label="Previous">‹</button>
    <button class="cc-lb-next" type="button" aria-label="Next">›</button>
    <figure class="cc-lb-figure">
      <img class="cc-lb-img" src="" alt="" />
      <figcaption class="cc-lb-caption"></figcaption>
    </figure>
    <div class="cc-lb-counter"></div>
  </div>
</div>

<script is:inline define:vars={{ photos }}>
  (function () {
    const grid = document.getElementById('cc-gallery-grid');
    const lb = document.getElementById('cc-lightbox');
    if (!grid || !lb) return;

    const img = lb.querySelector('.cc-lb-img');
    const cap = lb.querySelector('.cc-lb-caption');
    const counter = lb.querySelector('.cc-lb-counter');
    const closeBtn = lb.querySelector('.cc-lb-close');
    const prevBtn = lb.querySelector('.cc-lb-prev');
    const nextBtn = lb.querySelector('.cc-lb-next');
    let current = 0;

    function open(idx) {
      current = idx;
      render();
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lb.hidden = true;
      document.body.style.overflow = '';
    }
    function step(delta) {
      current = (current + delta + photos.length) % photos.length;
      render();
    }
    function render() {
      const p = photos[current];
      img.src = p.src;
      img.alt = p.caption || '';
      cap.textContent = p.caption || '';
      counter.textContent = `${current + 1} / ${photos.length}`;
    }

    grid.addEventListener('click', (e) => {
      const btn = e.target.closest('.cc-thumb');
      if (!btn) return;
      open(parseInt(btn.dataset.idx, 10));
    });
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });

    // Touch swipe (basic)
    let startX = 0;
    lb.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) step(dx > 0 ? -1 : 1);
    });
  })();
</script>

<style is:global>
  .cc-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .cc-thumb {
    position: relative;
    border: 0;
    padding: 0;
    background: #eee;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 4 / 3;
    transition: transform 0.2s ease;
  }
  .cc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .cc-thumb:hover {
    transform: translateY(-2px);
  }
  .cc-thumb:hover img {
    transform: scale(1.05);
  }
  .cc-thumb-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    pointer-events: none;
  }

  /* Lightbox */
  .cc-lightbox[hidden] { display: none; }
  .cc-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .cc-lb-figure {
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .cc-lb-img {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    object-fit: contain;
    border-radius: 8px;
  }
  .cc-lb-caption {
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    max-width: 800px;
    line-height: 1.5;
    text-align: center;
    padding: 0 16px;
  }
  .cc-lb-counter {
    position: absolute;
    top: 24px;
    left: 24px;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    background: rgba(255, 255, 255, 0.1);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .cc-lb-close,
  .cc-lb-prev,
  .cc-lb-next {
    position: absolute;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 26px;
    line-height: 1;
    transition: background 0.2s ease;
  }
  .cc-lb-close:hover,
  .cc-lb-prev:hover,
  .cc-lb-next:hover {
    background: rgba(255, 255, 255, 0.25);
  }
  .cc-lb-close { top: 24px; right: 24px; }
  .cc-lb-prev { left: 24px; top: 50%; transform: translateY(-50%); }
  .cc-lb-next { right: 24px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 768px) {
    .cc-lightbox { padding: 12px; }
    .cc-lb-close { top: 12px; right: 12px; width: 40px; height: 40px; font-size: 22px; }
    .cc-lb-prev { left: 8px; width: 40px; height: 40px; font-size: 22px; }
    .cc-lb-next { right: 8px; width: 40px; height: 40px; font-size: 22px; }
    .cc-lb-counter { top: 12px; left: 12px; font-size: 12px; }
  }
</style>
